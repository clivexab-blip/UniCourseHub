*.keystore
*.jks
!debug.keystore
google-services.json

# User specific files
*.swp
*~
.DS_Store
Thumbs.db

# Logs
*.log

# Mobile Specific
/app/release/
/app/debug/
*.apk
*.ap_
*.aab
*.dex
*.class
